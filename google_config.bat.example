@echo off
REM 1) Copy this file and rename the copy to google_config.bat (same folder).
REM 2) Fill in the two values below with what you got from Google Cloud Console.
REM 3) google_config.bat is listed in .gitignore, so it will never be committed.

set GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
set GOOGLE_CLIENT_SECRET=your_client_secret
set GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
